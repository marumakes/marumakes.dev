---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { ALIDADE_BROKEN_DEG } from '../lib/astrolabe';

// The same legend the front page carries, reading what this instrument reads.
// It was written in the other style - `Astrolabe · 7 pointers · Stopped` - which
// was the caption §6 once required everywhere and which the front page no
// longer speaks. Two plates of the same instrument were describing it in two
// different hands.
//
// `Broken`, not `Stopped`: the drawing was always meant to be a broken
// instrument rather than a halted one, and the docs had talked themselves into
// the other word. The judder is a mechanism fighting something that will not
// give, which is not what stopping looks like.
//
// The altitude is the one figure on the site that is not invented. The front
// page's alidade turns, so it holds no reading; this one is jammed at a real
// angle the drawing owns. Taken from the constant rather than typed, so
// regraduating the limb moves the caption with it.
const SPEC = [
	'Astrolabe no. 04',
	`Alt +${ALIDADE_BROKEN_DEG}° 00′`,
	'Broken',
];

const LINKS = [
	{ href: '/', label: '← Back to the front page', emphasis: 'filled' as const },
	{ href: '/field-notes', label: 'Field notes', emphasis: 'quiet' as const },
];
---

<BaseLayout title="Not Found - marumakes" description="No page is filed at this address.">
	{/* The front page's opening plate, word for word the same furniture, with
	    the instrument broken between graduations. */}
	<Hero
		eyebrow="Error 404"
		heading="Nothing filed at this address."
		dek="Not only was the search void, it seems to have jammed the astrolabe against one of the graduations..."
		links={LINKS}
		spec={SPEC}
		motion="broken"
	/>
</BaseLayout>

<style>
	/* Nothing follows the plate on this page. Left alone it hangs from the
	   masthead with a screen of blank paper beneath it, so here - and only
	   here - the plate sits in the middle of what is left.

	   `main` belongs to BaseLayout, so this has to reach out of scope. The
	   stylesheet ships with this page alone, which is as far as it reaches. */
	:global(main) {
		display: grid;
		align-content: center;
	}
</style>
