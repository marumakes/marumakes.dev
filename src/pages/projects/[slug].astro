---
import { getCollection, render } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { conditionLabel, monthYear, roman, wordCount, type Condition } from '../../lib/register';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

	// Only projects marked as case studies (currently: Parchment People) get
	// a page here - the rest link straight out to their repository from the
	// register. The plate number is the project's position in the whole
	// register, so it is worked out before filtering.
	return projects
		.filter((project) => project.data.caseStudy)
		.map((project) => ({
			params: { slug: project.id },
			props: { project, plate: roman(projects.indexOf(project) + 1) },
		}));
}

const { project, plate } = Astro.props;
const { Content } = await render(project);
const {
	title, tagline, stack, mounting, finish, firstLight, designation, condition, liveUrl, repoUrl,
} = project.data;

const spec = [
	{ term: 'Designation', value: designation },
	{ term: 'Movement', value: stack.join(' · ') },
	{ term: 'Mounting', value: mounting },
	{ term: 'Finish', value: finish },
	{ term: 'First light', value: monthYear(firstLight) },
	{ term: 'Condition', value: conditionLabel(condition as Condition) },
].filter((row): row is { term: string; value: string } => Boolean(row.value));

const links = [
	liveUrl ? { href: liveUrl, label: liveUrl.replace(/^https?:\/\/(www\.)?/, '') } : null,
	repoUrl ? { href: repoUrl, label: 'Repository' } : null,
].filter((link) => link !== null);
---

<ReadingLayout
	title={`${title} - marumakes`}
	description={tagline}
	eyebrow={`Plate ${plate} · ${designation}`}
	heading={title}
	standfirst={tagline}
	back={{ href: '/#register', label: 'The Register' }}
	spec={spec}
	seed={project.id}
	words={wordCount(project.body ?? '')}
	links={links}
>
	<Content />
</ReadingLayout>
