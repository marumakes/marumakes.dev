---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Register from '../components/Register.astro';
import NoteStack from '../components/NoteStack.astro';
import Correspondence from '../components/Correspondence.astro';
import GearDivider from '../components/GearDivider.astro';

// The caption an instrument maker would engrave on the piece itself: which one
// it is, what it is currently sighted at, and when its star positions are
// reckoned from. Altitude is the angle above the horizon in degrees and
// arcminutes; an epoch is the instant those positions are true for, since
// precession shifts them about 50" a year. The J is what makes it a Julian
// epoch, written the way J2000.0 is - the decimal is a fraction of the year,
// so .0 is 1 January.
//
// None of the three figures is checkable against the drawing, and that is
// settled rather than outstanding. It was cut once under the honesty rule and
// restored; Maru confirmed the preference on 31 Aug 2026. DESIGN.md §6 now
// scopes that rule to claims about real things - projects, dates, stacks - and
// says why a legend on a drawing of an instrument that does not exist is not
// one of them.
const HERO_SPEC = ['Astrolabe no. 04', 'Alt +41° 12′', 'Epoch J2026.0'];

const HERO_LINKS = [
	{ href: '#register', label: 'Read the register →', emphasis: 'filled' as const },
	{ href: '#field-notes', label: 'Field notes', emphasis: 'quiet' as const },
];

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// The stack opens on the newest note, so it is sorted by number descending -
// No. 1 is the first one written and sits deepest.
const notes = (await getCollection('creative')).sort((a, b) => b.data.order - a.data.order);
---

<BaseLayout
	title="Marumakes"
	description="A register of software instruments, field notes from the table, and how to write."
>
	<Hero
		eyebrow="Maru · Software Engineer"
		heading="I'm Maru, a "
		headingTail="maker of many things"
		dek="As a Computer Science student, I spend my time exploring cool tech by building projects I'm genuinely interested in, and by making tools to automate the boring parts of life. When I'm not coding, I'm often writing about D&D. "
		links={HERO_LINKS}
		spec={HERO_SPEC}
	/>

	<GearDivider order={0} />
	<Register projects={projects} />

	<GearDivider order={1} />
	<NoteStack notes={notes} />

	<GearDivider order={2} />
	<Correspondence />
</BaseLayout>
