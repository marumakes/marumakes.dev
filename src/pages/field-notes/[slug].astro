---
import { getCollection, render } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { monthYear, lengthLabel, wordCount } from '../../lib/register';

export async function getStaticPaths() {
	const notes = await getCollection('creative');

	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

const KINDS = {
	class: 'Class',
	monster: 'Monster',
	article: 'Article',
} as const;

const { note } = Astro.props;
const { Content } = await render(note);
const { title, summary, kind, order, filed } = note.data;

// The same four rows as the index card on the homepage stack, so the note
// carries its own catalogue entry through to the page.
const words = wordCount(note.body ?? '');

const spec = [
	{ term: 'Kind', value: KINDS[kind] },
	{ term: 'No.', value: String(order) },
	{ term: 'Filed', value: monthYear(filed) },
	{ term: 'Length', value: lengthLabel(words) },
];
---

<ReadingLayout
	title={`${title} - Marumakes`}
	description={summary}
	eyebrow={`Field note ${order} · ${KINDS[kind]}`}
	heading={title}
	standfirst={summary}
	back={{ href: '/#field-notes', label: 'Field Notes' }}
	spec={spec}
	seed={note.id}
	words={words}
>
	<Content />
</ReadingLayout>
