---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('creative');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary } = entry.data;
---

<BaseLayout title={`${title} — maru`} description={summary}>
	<article class="wrap piece">
		<a class="back" href="/creative">← Creative</a>
		<h1>{title}</h1>
		<p class="summary">{summary}</p>
		<div class="body">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.piece {
		padding-block: 2rem 5rem;
		max-width: 42rem;
	}
	.back {
		font-size: 0.85rem;
		color: var(--ink-faint);
		text-decoration: none;
	}
	h1 {
		font-size: 2rem;
		margin-top: 1rem;
	}
	.summary {
		color: var(--ink-soft);
		margin-top: 0.75rem;
		font-size: 1.05rem;
	}
	.body {
		margin-top: 2.5rem;
		line-height: 1.7;
	}
	.body :global(p) {
		color: var(--ink-soft);
		margin-bottom: 1rem;
	}
</style>
