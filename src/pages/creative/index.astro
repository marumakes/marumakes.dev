---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('creative')).sort((a, b) => a.data.order - b.data.order);
const homebrew = entries.filter((e) => e.data.kind === 'class' || e.data.kind === 'monster');
const articles = entries.filter((e) => e.data.kind === 'article');
---

<BaseLayout title="Creative — maru" description="Homebrew D&D content and articles, separate from the software projects.">
	<div class="wrap creative">
		<a class="back" href="/">← maru</a>
		<h1>Creative</h1>
		<p class="dek">
			The other thing I build. Homebrew D&amp;D content, and a couple of articles — some
			about running games, some just because I like the lore.
		</p>

		<h2>Homebrew</h2>
		<ul class="entry-list">
			{
				homebrew.map((entry) => (
					<li>
						<a href={`/creative/${entry.id}`}>{entry.data.title}</a>
						<p>{entry.data.summary}</p>
					</li>
				))
			}
		</ul>

		<h2>Articles</h2>
		<ul class="entry-list">
			{
				articles.map((entry) => (
					<li>
						<a href={`/creative/${entry.id}`}>{entry.data.title}</a>
						<p>{entry.data.summary}</p>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>

<style>
	.creative {
		padding-block: 2rem 5rem;
		max-width: 42rem;
	}
	.back {
		font-size: 0.85rem;
		color: var(--ink-faint);
		text-decoration: none;
	}
	h1 {
		font-size: 2.25rem;
		margin-top: 1rem;
	}
	.dek {
		margin-top: 1rem;
		color: var(--ink-soft);
		max-width: 52ch;
	}
	h2 {
		font-size: 1.2rem;
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
	}
	.entry-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.entry-list li {
		border: 1px solid var(--hairline);
		border-radius: 8px;
		padding: 1rem 1.25rem;
	}
	.entry-list a {
		text-decoration: none;
		font-weight: 600;
	}
	.entry-list p {
		margin-top: 0.35rem;
		color: var(--ink-soft);
		font-size: 0.92rem;
	}
</style>
