---
import { ClientRouter } from 'astro:transitions';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';
import PaperGrain from '../components/PaperGrain.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

// Three faces, three jobs.
//
// Bodoni Moda is requested *without* its optical-size axis on purpose. With
// `opsz` in the request the browser sizes it automatically, and at hero size
// picks the display cut - whose hairlines are so fine the headings look faded.
// Omitting the axis serves the text cut at every size, which is the weight the
// design was signed off at.
const FONTS =
	'https://fonts.googleapis.com/css2' +
	'?family=Bodoni+Moda:ital,wght@0,400;0,500;1,400' +
	'&family=IBM+Plex+Mono:wght@400;500' +
	'&family=Spectral:ital,wght@0,300;0,400;0,500;1,400' +
	'&display=swap';

// This page's one true address, resolved against `site` in astro.config.mjs.
// The path carries a trailing slash on every page but the front one, because
// Astro emits each route as its own directory.
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />
		<meta property="og:url" content={canonical} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={FONTS} />
		<title>{title}</title>
		<ClientRouter />
		{/* Render-blocking on purpose, and inline so it cannot arrive late: it
		    runs before the first paint and there is no flash of the day sheet.

		    No stored choice means no attribute, which leaves the reader on
		    prefers-color-scheme. That is also what a reader with JavaScript off
		    gets, so the site is themed either way - only the toggle needs JS. */}
		<script is:inline>
			(() => {
				const KEY = 'marumakes-theme';

				function apply() {
					const stored = localStorage.getItem(KEY);

					if (stored === 'light' || stored === 'dark') {
						document.documentElement.dataset.theme = stored;
						return;
					}

					delete document.documentElement.dataset.theme;
				}

				apply();

				// The client router copies <html>'s attributes from the incoming
				// document, which drops data-theme on every navigation. after-swap
				// fires before the new page is painted; page-load fires after it,
				// and would flash the day sheet each time.
				//
				// document survives a swap, so one listener covers every later
				// navigation - and the flag stops a second one being added if the
				// router chooses to re-run this script.
				if (!window.__themeBound) {
					window.__themeBound = true;
					document.addEventListener('astro:after-swap', apply);
				}
			})();
		</script>
	</head>
	<body>
		<PaperGrain />
		<div class="sheet">
			<Masthead />
			<main>
				<slot />
			</main>
			<Colophon />
		</div>
	</body>
</html>

<style>
	body {
		/* The ghosted wheel deliberately runs past the right edge, and a reading
		   page's marginal wheels run past both - they are drawn larger than the
		   margins holding them so that some are cut off by the window. Without
		   this, every overrun would widen the document and the page would scroll
		   sideways.

		   `clip`, not `hidden`: hidden would make this a scroll container, and
		   the index card in a reading page's right margin is `position: sticky`
		   against the viewport. It would stop sticking. */
		overflow-x: clip;
	}

	/* Full-bleed, always. The masthead rack and the colophon run the width of
	   the window on every page; only a reading column narrows, and it does that
	   itself - see ReadingLayout.

	   The column is at least a screen tall so the colophon is held at the foot
	   of the window on a page too short to fill one - otherwise it rides up
	   under the content and reads as the end of a page that has not ended. */
	.sheet {
		position: relative;
		z-index: 3;
		padding-inline: var(--gut);
		padding-block: 2rem 3.5rem;
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
	}

	/* Grow, never shrink: `flex: 1` alone would let a long page's content be
	   compressed to the basis of zero it implies. */
	main { flex: 1 0 auto; }
</style>
