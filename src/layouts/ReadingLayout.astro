---
import BaseLayout from './BaseLayout.astro';
import MarginalWheels from '../components/MarginalWheels.astro';
import ReadingGauge from '../components/ReadingGauge.astro';

interface SpecRow {
	term: string;
	value: string;
}

interface Props {
	title: string;
	description: string;
	/** Where this page sits - "Plate II" for a case study, "No. 3" for a note. */
	eyebrow: string;
	heading: string;
	standfirst: string;
	back: { href: string; label: string };
	spec: SpecRow[];
	links?: { href: string; label: string }[];
	/** Fixes this page's marginal wheels - pass the entry's slug. */
	seed: string;
	/** Length of the piece, so short drafts don't get furniture they can't carry. */
	words: number;
}

const { title, description, eyebrow, heading, standfirst, back, spec, links = [], seed, words } =
	Astro.props;
---

<BaseLayout title={title} description={description}>
	{/* Ornament thins out as you move inward: a document, not a poster. Two
	    ghosted wheels out in the gutters, and otherwise a single centred
	    column - title, standfirst and text all on one measure. */}
	<article class="document">
		<a class="back" href={back.href}>← {back.label}</a>

		<header class="masthead">
			<p class="eyebrow">{eyebrow}</p>
			<h1>{heading}</h1>
			<p class="standfirst">{standfirst}</p>
			{
				links.length > 0 && (
					<div class="links">
						{links.map((link) => (
							<a href={link.href}>{link.label} →</a>
						))}
					</div>
				)
			}
		</header>

		<div class="margin margin-left" aria-hidden="true">
			<div class="drawings">
				<MarginalWheels seed={seed} words={words} side="left" />
			</div>
			<div class="rule">
				<ReadingGauge />
			</div>
		</div>

		<div class="prose">
			<slot />
		</div>

		<div class="margin margin-right">
			<dl class="spec">
				{spec.map((row) => (
					<div>
						<dt>{row.term}</dt>
						<dd>{row.value}</dd>
					</div>
				))}
			</dl>
			<div class="drawings" aria-hidden="true">
				<MarginalWheels seed={seed} words={words} side="right" />
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	/* One centred text column, with a gutter either side. The card lives in
	   the right gutter, so the text is centred on the page rather than the
	   text-plus-card block being centred - which is what left the title
	   looking wider than the prose beneath it.

	   `position: relative` anchors the marginal wheels. */
	.document {
		position: relative;
		padding-block: clamp(2rem, 6vh, 3.5rem) 2rem;
		display: grid;

		/* Space between a margin's drawings and the furniture beside them. */
		--margin-gap: 1.25rem;

		grid-template-columns:
			[gutter-left] minmax(0, 1fr)
			[measure] minmax(0, var(--reading))
			[gutter-right] minmax(0, 1fr);
		column-gap: var(--card-gap);
	}

	/* Everything the reader reads sits on one measure. */
	.back,
	.masthead,
	.prose { grid-column: measure; }

	/* Each gutter is a grid of its own: drawings get one track, and the
	   furniture beside them - the gauge on the left, the index card on the
	   right - gets another. Splitting them is what stops a wheel growing into
	   the gauge, and it means neither has to work out the other's width. */
	.margin {
		grid-row: 3;
		height: 100%;
		display: grid;
		column-gap: var(--margin-gap);
	}

	.margin-left {
		grid-column: gutter-left;
		grid-template-columns: [drawings] minmax(0, 1fr) [gauge] auto;
	}

	/* Drawings out at the page edge, card against the text. */
	.margin-right {
		grid-column: gutter-right;
		grid-template-columns: [card] auto [drawings] minmax(0, 1fr);
	}

	/* The space a margin's wheels may occupy, and a positioning context for
	   them. It does not work out its own width; the track does. */
	.drawings {
		grid-column: drawings;
		position: relative;
		height: 100%;
		pointer-events: none;
	}

	.rule {
		grid-column: gauge;
		height: 100%;
		pointer-events: none;
	}

	/* No gutter left to draw in. The card still has somewhere to go, so only
	   the drawings and the gauge leave. */
	@media (max-width: 1240px) {
		.margin-left,
		.drawings { display: none; }
	}

	.back {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink-faint);
		text-decoration: none;
	}

	.back:hover { color: var(--gold); }

	.masthead {
		margin-top: 2rem;
		padding-bottom: 1.6rem;
		border-bottom: 1px solid var(--gold-mid);
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: var(--gold);
		margin-bottom: 1rem;
		font-variant-numeric: tabular-nums;
	}

	h1 {
		font-family: var(--font-display);
		font-size: clamp(2.1rem, 4.6vw, 3.4rem);
		line-height: 1.08;
		/* Wide enough that a title like "6 Lessons I Learnt Running a D&D
		   Party of 9" balances across two lines rather than three. */
		max-width: 24ch;
		color: var(--ink);
	}

	.standfirst {
		margin-top: 1.2rem;
		max-width: 56ch;
		font-size: 1.06rem;
		color: var(--ink-soft);
	}

	.links {
		display: flex;
		gap: 1.6rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.63rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.links a {
		color: var(--gold);
		text-decoration: none;
		padding-bottom: 3px;
		border-bottom: 1px solid var(--rule);
	}

	.links a:hover { color: var(--ink); border-bottom-color: var(--gold); }


	/* Out in the right gutter, level with the top of the text, and sticky so
	   it stays with the reader down a long article. */
	.spec {
		grid-column: card;
		align-self: start;
		position: sticky;
		top: 2rem;
		display: grid;
		gap: 0.9rem;
		margin: 0;
		/* Only as wide as its longest value ("~1,400 words") needs. Every rem
		   spent here comes straight out of the drawing track beside it, which
		   is the narrower of the two margins by a long way. */
		width: 9rem;
		font-family: var(--font-mono);
		font-size: 0.63rem;
		border-left: 1px solid var(--rule);
		padding-left: 1.4rem;
	}

	/* Once the gutters are too narrow to hold it, the card comes back into the
	   column and sits under the title - still before the text, so it reads as
	   a catalogue entry rather than a footnote. */
	@media (max-width: 1240px) {
		.document { grid-template-columns: minmax(0, var(--reading)); justify-content: center; }
		.back, .masthead, .prose { grid-column: 1; }

		/* The right margin is now only the card, so it stops being a grid and
		   comes back into the column as one. */
		.margin-right {
			grid-column: 1;
			grid-row: auto;
			order: -1;
			display: block;
			height: auto;
		}

		.spec {
			position: static;
			width: auto;
			grid-auto-flow: column;
			grid-auto-columns: max-content;
			gap: 1.6rem;
			border-left: 0;
			border-top: 1px solid var(--rule);
			padding: 1.1rem 0 0;
			margin-bottom: 1.5rem;
		}
	}

	@media (max-width: 620px) {
		.spec { grid-auto-flow: row; gap: 0.8rem; }
	}

	.spec div { display: grid; gap: 0.12rem; }
	.spec dt { font-size: 0.54rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }
	.spec dd { margin: 0; color: var(--ink); font-variant-numeric: tabular-nums; }

	/* Rendered markdown. :global because the content comes from <Content />. */
	.prose :global(h2) {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.4vw, 1.75rem);
		margin-top: 2.6rem;
		color: var(--ink);
	}

	.prose :global(h3) {
		font-family: var(--font-display);
		font-size: 1.2rem;
		margin-top: 2rem;
		color: var(--ink);
	}

	.prose :global(p) { margin-top: 1.1rem; color: var(--ink-soft); }
	.prose :global(strong) { color: var(--ink); font-weight: 500; }
	.prose :global(em) { font-style: italic; }

	.prose :global(a) { color: var(--gold); text-underline-offset: 3px; }
	.prose :global(a:hover) { color: var(--ink); }

	.prose :global(ul),
	.prose :global(ol) { margin-top: 1.1rem; padding-left: 1.3rem; color: var(--ink-soft); }
	.prose :global(li) { margin-top: 0.4rem; }

	.prose :global(blockquote) {
		margin: 1.6rem 0 0;
		padding-left: 1.2rem;
		border-left: 1px solid var(--gold-mid);
		font-style: italic;
		color: var(--ink-soft);
	}

	.prose :global(hr) {
		margin: 2.4rem 0 0;
		border: 0;
		border-top: 1px solid var(--rule);
	}

	/* Code is set in the label face at reading size - the one place mono is
	   allowed past 0.7rem, because it is quoting a machine rather than
	   labelling an instrument. */
	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		color: var(--ink);
	}

	.prose :global(pre) {
		margin-top: 1.3rem;
		padding: 1rem 1.2rem;
		background: var(--paper-2);
		border: 1px solid var(--rule);
		overflow-x: auto;
	}

	.prose :global(img) { margin-top: 1.4rem; border: 1px solid var(--rule); }

	/* A ruled plate: the same language as the register's spec column - a mono
	   gold header over ink readings, ruled top and bottom in the structural
	   gold, and set tighter than the prose around it so it reads as tabulated
	   reference rather than a stray run of paragraphs. */
	.prose :global(table) {
		width: 100%;
		margin-top: 1.9rem;
		border-collapse: collapse;
		font-variant-numeric: tabular-nums;
		border-top: 1px solid var(--gold-mid);
		border-bottom: 1px solid var(--gold-mid);
	}

	/* Column headers are labels, so they speak in the site's label voice -
	   the spec card's size and tracking exactly. */
	.prose :global(th) {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 0.56rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gold);
		text-align: left;
		vertical-align: bottom;
		padding: 0.85rem 2.25rem 0.7rem 0;
		border-bottom: 1px solid var(--rule);
	}

	/* No rule between rows. Three rules carry the whole table - the row
	   rhythm does the grouping, which is what keeps it quiet enough to sit
	   next to the spec card. */
	.prose :global(td) {
		padding: 0.42rem 2.25rem 0.42rem 0;
		font-size: 0.94rem;
		line-height: 1.5;
		color: var(--ink-soft);
		vertical-align: baseline;
	}

	/* Breathing room inside the outer rules, so the readings sit on the plate
	   rather than against its edges. */
	.prose :global(tbody tr:first-child td) { padding-top: 0.8rem; }
	.prose :global(tbody tr:last-child td) { padding-bottom: 0.85rem; }

	/* The first column labels its row - give it the ink weight so the table
	   reads left-to-right off a strong edge, like dt/dd in the spec list. */
	.prose :global(tbody th),
	.prose :global(td:first-child) {
		color: var(--ink);
		font-weight: 500;
	}

	.prose :global(tr > :last-child) { padding-right: 0; }

	/* Markdown's alignment syntax (|---:|) emits a presentational `align`
	   attribute, which loses to any rule in a stylesheet - so the alignment
	   has to be honoured here or the column quietly ignores it. */
	.prose :global(th[align='right']),
	.prose :global(td[align='right']) { text-align: right; }

	.prose :global(th[align='center']),
	.prose :global(td[align='center']) { text-align: center; }

	/* On a narrow screen a wide table scrolls in place rather than pushing the
	   column sideways. */
	@media (max-width: 620px) {
		.prose :global(table) { display: block; overflow-x: auto; }
	}
</style>
