---
import Instrument from './Instrument.astro';
import type { Motion } from '../lib/astrolabe';

/* The opening plate: lede on the left, instrument facing it on the right, an
   engraved caption beneath. The front page and the 404 are the same plate with
   different words — and on the 404, an instrument that has stopped. Both take
   their layout from here, so neither can drift from the other. */

interface Props {
	eyebrow: string;
	heading: string;
	/** The italic gold tail of a heading, for headings that have one. */
	headingTail?: string;
	dek: string;
	/** One filled link and however many quiet ones. */
	links: { href: string; label: string; emphasis: 'filled' | 'quiet' }[];
	/** The caption engraved under the drawing. Every part of it has to be true
	    of the drawing itself — see design/DESIGN.md §6. */
	spec: string[];
	motion?: Motion;
}

const { eyebrow, heading, headingTail, dek, links, spec, motion } = Astro.props;
---

<div class="hero">
	<div>
		<p class="eyebrow">{eyebrow}</p>
		<h1>{heading}{headingTail && <Fragment>{' '}<em>{headingTail}</em></Fragment>}</h1>
		<p class="dek">{dek}</p>
		<div class="cta">
			{
				links.map((link) => (
					<a class={link.emphasis === 'quiet' ? 'quiet' : undefined} href={link.href}>
						{link.label}
					</a>
				))
			}
		</div>
	</div>

	<figure class="figure">
		<Instrument motion={motion} />
		<figcaption>
			{spec.map((item, index) => <span class={index === 0 ? 'name' : undefined}>{item}</span>)}
		</figcaption>
	</figure>
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
		padding-block: clamp(3rem, 9vh, 6rem);
	}

	@media (max-width: 940px) {
		.hero { grid-template-columns: 1fr; gap: 2.5rem; }
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--gold);
		margin-bottom: 1.6rem;
	}

	h1 {
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 6.2vw, 4.9rem);
		font-weight: 400;
		line-height: 1.06;
		max-width: 15ch;
		color: var(--ink);
	}

	h1 em {
		font-style: italic;
		color: var(--gold);
	}

	.dek {
		margin-top: 1.8rem;
		max-width: 52ch;
		color: var(--ink-soft);
	}

	.cta {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
		align-items: center;
		margin-top: 2.4rem;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.cta a {
		color: var(--paper-2);
		background: var(--ink);
		text-decoration: none;
		padding: 0.7rem 1.4rem;
		border: 1px solid var(--ink);
	}

	.cta a:hover { background: #322c24; border-color: #322c24; }

	.cta a.quiet {
		color: var(--ink);
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--gold-mid);
		padding: 0.7rem 0 0.5rem;
	}

	.cta a.quiet:hover { color: var(--gold); border-bottom-color: var(--gold); }

	.figure { margin: 0; }

	figcaption {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 1.1rem;
		padding-top: 0.7rem;
		border-top: 1px solid var(--gold-mid);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-faint);
		font-variant-numeric: tabular-nums;
	}

	figcaption .name { color: var(--gold); }
</style>
