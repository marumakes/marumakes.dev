---
import { astrolabe } from '../lib/astrolabe';

/* The caption an instrument maker would engrave on the piece itself:
   which one it is, what it is currently sighted at, and when its star
   positions are reckoned from. See design/DESIGN.md §6. */
const SPEC = ['Astrolabe no. 04', 'Alt +41° 12′', 'Epoch 2026.0'];
---

<div class="hero">
	<div>
		<p class="eyebrow">Maru · Software Engineer</p>
		<h1>Lorem ipsum dolor <em>sit amet elit</em></h1>
		<p class="dek">
			Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
			incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud
			exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
		</p>
		<div class="cta">
			<a href="#register">Read the register →</a>
			<a class="quiet" href="#field-notes">Field notes</a>
		</div>
	</div>

	<figure class="figure">
		<svg
			class="instrument"
			viewBox="0 0 420 420"
			role="img"
			aria-label="An engraved astrolabe: a graduated limb, an almucantar plate, a slowly turning rete of star pointers, and a sighting alidade"
			set:html={astrolabe()}
		/>
		<figcaption>
			{SPEC.map((item, index) => <span class={index === 0 ? 'name' : undefined}>{item}</span>)}
		</figcaption>
	</figure>
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
		padding-block: clamp(3rem, 9vh, 6rem);
	}

	@media (max-width: 940px) {
		.hero { grid-template-columns: 1fr; gap: 2.5rem; }
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--gold);
		margin-bottom: 1.6rem;
	}

	h1 {
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 6.2vw, 4.9rem);
		font-weight: 400;
		line-height: 1.06;
		max-width: 15ch;
		color: var(--ink);
	}

	h1 em {
		font-style: italic;
		color: var(--gold);
	}

	.dek {
		margin-top: 1.8rem;
		max-width: 52ch;
		color: var(--ink-soft);
	}

	.cta {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
		align-items: center;
		margin-top: 2.4rem;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.cta a {
		color: var(--paper-2);
		background: var(--ink);
		text-decoration: none;
		padding: 0.7rem 1.4rem;
		border: 1px solid var(--ink);
	}

	.cta a:hover { background: #322c24; border-color: #322c24; }

	.cta a.quiet {
		color: var(--ink);
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--gold-mid);
		padding: 0.7rem 0 0.5rem;
	}

	.cta a.quiet:hover { color: var(--gold); border-bottom-color: var(--gold); }

	.figure { margin: 0; }
	.instrument { width: 100%; height: auto; display: block; }

	/* Every stroke-only class has to name its fill: SVG's default is black,
	   which on parchment paints a solid disc over the whole drawing. */
	.instrument :global(.hair) { fill: none; stroke: var(--rule); stroke-width: 0.7; }
	.instrument :global(.rule-gold) { fill: none; stroke: var(--gold-mid); stroke-width: 0.8; }
	.instrument :global(.rule-gold-strong) { fill: none; stroke: var(--gold); stroke-width: 1; }
	.instrument :global(.ink) { fill: none; stroke: var(--ink-faint); stroke-width: 0.8; }
	.instrument :global(.ecliptic) { fill: none; stroke: var(--mauve); stroke-width: 1.1; }
	.instrument :global(.pointer) { fill: none; stroke: var(--mauve-soft); stroke-width: 0.8; }
	.instrument :global(.star) { fill: var(--mauve); stroke: none; }
	.instrument :global(.fitting) { fill: var(--paper-2); stroke: var(--gold); stroke-width: 0.9; }
	.instrument :global(.hub) { fill: var(--gold); stroke: none; }

	.instrument :global(text) {
		font-family: var(--font-mono);
		font-size: 6.5px;
		letter-spacing: 0.16em;
		fill: var(--ink-faint);
	}

	/* The ecliptic draws itself in once, as if being struck. pathLength="1"
	   on the circle is what lets one dash length cover any radius. */
	.instrument :global(.trace-in) {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: trace 2.8s ease-out forwards;
	}

	@keyframes trace {
		to { stroke-dashoffset: 0; }
	}

	figcaption {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 1.1rem;
		padding-top: 0.7rem;
		border-top: 1px solid var(--gold-mid);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-faint);
		font-variant-numeric: tabular-nums;
	}

	figcaption .name { color: var(--gold); }
</style>
