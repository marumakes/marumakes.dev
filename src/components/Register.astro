---
import type { CollectionEntry } from 'astro:content';
import { ghostWheel } from '../lib/mechanism';
import { yearOf } from '../lib/register';
import RegisterEntry from './RegisterEntry.astro';
import SectionHead from './SectionHead.astro';

interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

// The range comes from the entries themselves rather than being written down,
// so it can't drift when a project is added. Years only: the head is a span,
// and a span written to the month would be finer than the thing it summarises.
//
// One year on both ends collapses to a single figure rather than reading
// "2026 - 2026", which is what the register will say once the placeholder dates
// are confirmed and most of them land in the same year.
const years = projects.map((project) => Number(yearOf(project.data.firstLight)));
const first = Math.min(...years);
const last = Math.max(...years);
const span = `${projects.length} instruments · ${first === last ? first : `${first} – ${last}`}`;
---

<section class="register" aria-labelledby="register">
	<svg class="ghost" viewBox="0 0 560 560" aria-hidden="true" set:html={ghostWheel()} />
	<SectionHead id="register" title="The Register" meta={span} />
	{projects.map((project, index) => <RegisterEntry project={project} position={index + 1} />)}
</section>

<style>
	.register {
		padding-top: clamp(2rem, 5vh, 3.4rem);
		position: relative;
	}

	/* A great wheel ghosted behind the entries, running off the right edge
	   the way it would on a shop drawing that was never trimmed. */
	.ghost {
		position: absolute;
		top: 6rem;
		right: -14rem;
		width: 34rem;
		z-index: -1;
		pointer-events: none;
		opacity: 0.6;
	}

	.ghost :global(.ring) { fill: none; stroke: var(--line-ghost); stroke-width: 1; }

	@media (max-width: 1100px) {
		.ghost { display: none; }
	}
</style>
