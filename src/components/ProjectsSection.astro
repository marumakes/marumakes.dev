---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

// getCollection reads every file in src/content/projects/, validates each
// one against the schema in content.config.ts, and hands back typed data —
// this is the array that ProjectCard.astro renders one card per entry from.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="wrap projects">
	<h2>Projects</h2>
	<div class="grid">
		{projects.map((project) => <ProjectCard entry={project} />)}
	</div>
</section>

<style>
	.projects {
		padding-block: 2rem 4rem;
	}
	h2 {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
	}
</style>
