---
/** Brand and navigation, sitting on a toothed rack - the first piece of
    mechanism on the page, and the only one in the masthead. */

// Field Notes goes to the archive rather than the homepage stack: the stack is
// a taster that only ever shows one note open, so a reader who deliberately
// asks for the notes should land on all of them.
const links = [
	{ href: '/#register', label: 'Register' },
	{ href: '/field-notes', label: 'Field Notes' },
	{ href: '/#correspondence', label: 'Correspondence' },
];
---

<header class="head">
	<a class="brand" href="/">Marumakes</a>
	<nav class="nav" aria-label="Sections">
		{/* At the head of the nav group rather than trailing it: alone past the
		    last link it sat out at the window's edge and read as a stray mark.
		    It is here rather than in the colophon because a switch that changes
		    how the page looks is no use at the bottom of it. Hidden until the
		    script claims it - without JavaScript the sheet still follows the
		    system, and a dead button would be worse than none. */}
		<button class="sheet-control" type="button" aria-pressed="false" hidden>
			{/* The name is here for assistive tech and nowhere else.

			    Three drawings failed here - a sun with eight rays, the bare
			    astronomical signs, and a sun and crescent rising over a horizon -
			    and every post-mortem blamed the drawing. It was not the drawing. A
			    16px glyph was being asked to say on its own what the button did, and
			    it was too small and too muddy to do it. Drawn whole at 18px it can:
			    a sun and a moon are what a reader already knows this control by,
			    which is the one thing no amount of refinement could have given a
			    graduated index.

			    A visible mono label was carried for a while as the fix and is now
			    off again - it was answering a question the drawing had stopped
			    asking. What it must not take with it is the accessible name: an
			    aria-hidden glyph in a bare button is a control that announces
			    nothing at all.

			    Both labels ship and aria-pressed picks one, so the state lives in a
			    single attribute and the script never touches the markup. It names
			    the sheet you are *on*: reporting the current condition is what the
			    other instrument on this page does. */}
			<span class="sheet-name day">Day sheet</span>
			<span class="sheet-name night">Night sheet</span>

			{/* A sun and a crescent - the convention, and now able to carry it.

			    A graduated index was tried here and pulled: it was the right layer
			    and the wrong read, a two-stop meter that looked like a fragment of
			    the rack rather than a control. The sun and moon are what everyone
			    already knows this button by, and with the label beside them they no
			    longer have to do the job alone, which is what defeated all three
			    earlier drawings.

			    Drawn at 18px rather than the 16 that failed, stroked at the rack's
			    weight, and with no horizon: the ground line read as an underline,
			    and the setting-and-rising it existed for is gone now that the whole
			    page cross-fades. One mark, whole, at a size that can hold it.

			    Eight rays, evenly spaced and all the same length. Six was tried and
			    was a mistake of a particular kind: four cardinals plus two of the
			    four diagonals, which is not a sparser sun but a broken one - the eye
			    reads the missing two as dropped rather than as a choice. A ray
			    pattern has to be rotationally symmetric or it looks like a bug,
			    which is exactly how it was reported.

			    The earlier "eight read as fussy" finding was about eight rays of
			    *alternating* length at 16px. Eight equal rays at 18px leave about
			    5.8 units between tips at 1.1 stroke, which is not crowded.

			    Every stroked shape carries fill="none" outright: a stroke-only class
			    that omits it renders as a solid black disc. */}
			<svg class="mark day" aria-hidden="true" viewBox="0 0 18 18" width="18" height="18">
				<circle class="ring" cx="9" cy="9" r="3.6" fill="none" />
				<g class="ray" fill="none">
					<line x1="9" y1="3.7" x2="9" y2="1.5" />
					<line x1="12.75" y1="5.25" x2="14.3" y2="3.7" />
					<line x1="14.3" y1="9" x2="16.5" y2="9" />
					<line x1="12.75" y1="12.75" x2="14.3" y2="14.3" />
					<line x1="9" y1="14.3" x2="9" y2="16.5" />
					<line x1="5.25" y1="12.75" x2="3.7" y2="14.3" />
					<line x1="3.7" y1="9" x2="1.5" y2="9" />
					<line x1="5.25" y1="5.25" x2="3.7" y2="3.7" />
				</g>
			</svg>
			<svg class="mark night" aria-hidden="true" viewBox="0 0 18 18" width="18" height="18">
				<path class="ring" d="M11.2 2.9a6.6 6.6 0 1 0 0 12.2 7.4 7.4 0 0 1 0-12.2z" fill="none" />
			</svg>
		</button>
		{links.map((link) => <a href={link.href}>{link.label}</a>)}
	</nav>
</header>
<div class="rack" aria-hidden="true"></div>

<style>
	.head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding-bottom: 1.1rem;
	}

	.brand {
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.3vw, 1.85rem);
		font-weight: 500;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--ink);
		text-decoration: none;
		line-height: 1;
	}

	.nav {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}

	.nav a {
		color: var(--ink-soft);
		text-decoration: none;
		padding-bottom: 3px;
		border-bottom: 1px solid transparent;
	}

	.nav a:hover {
		color: var(--gold);
		border-bottom-color: var(--gold-mid);
	}

	/* Takes the nav links' own type and colours so it reads as a sibling of
	   theirs, held one gap further out because it is a control, not a
	   destination. A button inherits none of .nav's font, so it is restated
	   here rather than left to cascade.

	   Baseline, not centre: the nav is baseline-aligned, and centring the
	   button's own box left the label sitting a little high against the links. */
	.sheet-control {
		display: inline-flex;
		align-items: center;
		background: none;
		border: 0;
		padding: 0 0 3px;
		cursor: pointer;
		color: var(--ink-soft);
		line-height: inherit;
	}

	.sheet-control[hidden] { display: none; }
	.sheet-control:hover { color: var(--gold); }

	/* One of each pair is always off. Not visibility: the hidden one must not be
	   read out, or the button announces both sheets at once. */
	.sheet-control[aria-pressed='false'] .night,
	.sheet-control[aria-pressed='true'] .day { display: none; }

	/* The name never shows - the glyph is the visible control. It is still the
	   button's whole accessible name, so it has to stay in the accessibility
	   tree: taken out of flow, not `display: none`. */
	.sheet-name {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* An SVG has no baseline of its own, so it is centred against the label
	   rather than left to sit on the text's. */
	.mark { align-self: center; }

	/* Stroke follows `color`, so the hover above reaches disc and rays at once,
	   at the same weight as the rack below. Round caps because the rays are
	   short: cut square at this length they read as ticks. */
	.mark :global(.ring) { stroke: currentColor; stroke-width: 1.1; }

	.mark :global(.ray) {
		stroke: currentColor;
		stroke-width: 1.1;
		stroke-linecap: round;
	}

	/* A cut rack: teeth above a solid rail.

	   The teeth were briefly dimmed on the night sheet, on the argument that at
	   full strength each one reads as a dash. It was wrong: the geometry never
	   moved, but dropping the teeth below the rail let the rail dominate and the
	   whole rack read as a finer, busier scale than it is. Teeth and rail are
	   the same ink, on both sheets. */
	.rack {
		height: 9px;
		background-image: repeating-linear-gradient(90deg, var(--gold-mid) 0 3px, transparent 3px 10px);
		background-size: 100% 4px;
		background-repeat: no-repeat;
		border-top: 1px solid var(--gold-mid);
	}
</style>

<script>
	// Shared with the pre-paint script in BaseLayout, which reads the same key
	// before the first frame.
	const KEY = 'marumakes-theme';
	const DARK = '(prefers-color-scheme: dark)';
	const STILL = '(prefers-reduced-motion: reduce)';

	type Sheet = 'light' | 'dark';

	// Not in lib.dom yet in this TS version, and the call has to be feature-
	// detected anyway.
	type Fadeable = Document & {
		startViewTransition?: (change: () => void) => { finished: Promise<void> };
	};

	/** Which sheet is actually on screen, stored choice or system preference. */
	function current(): Sheet {
		const stored = localStorage.getItem(KEY);

		if (stored === 'light' || stored === 'dark') {
			return stored;
		}

		return window.matchMedia(DARK).matches ? 'dark' : 'light';
	}

	/** Swap the inks. Everything visual about the change is elsewhere. */
	function print(next: Sheet, button: HTMLButtonElement) {
		const root = document.documentElement;

		// Held for one frame so the handful of colour transitions on the page do
		// not ease across the swap - see global.css.
		root.dataset.themeSwitching = '';
		localStorage.setItem(KEY, next);
		root.dataset.theme = next;
		button.setAttribute('aria-pressed', String(next === 'dark'));
		document.dispatchEvent(new CustomEvent('marumakes:themechange'));

		requestAnimationFrame(() => {
			requestAnimationFrame(() => delete root.dataset.themeSwitching);
		});
	}

	function bind() {
		const button = document.querySelector<HTMLButtonElement>('.sheet-control');

		if (!button) {
			return;
		}

		// Claimed by the script, so it only ever appears where it works.
		button.hidden = false;
		button.setAttribute('aria-pressed', String(current() === 'dark'));

		button.addEventListener('click', () => {
			const next = current() === 'dark' ? 'light' : 'dark';
			const root = document.documentElement;
			const fade = (document as Fadeable).startViewTransition;

			// A view transition is not an animation-duration, so the global
			// reduced-motion clamp cannot reach it. The preference is read here or
			// it is not honoured at all.
			if (!fade || window.matchMedia(STILL).matches) {
				print(next, button);
				return;
			}

			// Scoped to this attribute so the 350ms in global.css applies to the
			// sheet swap alone. The client router runs its own view transition on
			// every navigation, and an unscoped rule would slow all of those too.
			root.dataset.sheetFade = '';

			fade.call(document, () => print(next, button)).finished.finally(() => {
				delete root.dataset.sheetFade;
			});
		});
	}

	// Runs on first load and after every client-side navigation: the masthead
	// is re-rendered by the swap, so the new button needs claiming too.
	document.addEventListener('astro:page-load', bind);
</script>
