---
const year = new Date().getFullYear();
---

<footer class="footer">
	<p>© {year} maru</p>
	<a href="https://github.com/marumakes" target="_blank" rel="noreferrer">GitHub ↗</a>
</footer>

<style>
	.footer {
		display: flex;
		justify-content: space-between;
		padding-block: 2rem 3rem;
		color: var(--ink-faint);
		font-size: 0.875rem;
		border-top: 1px solid var(--hairline);
		margin-top: 4rem;
	}
	.footer a {
		color: var(--ink-faint);
		text-decoration: none;
	}
	.footer a:hover {
		color: var(--ink);
	}
</style>
