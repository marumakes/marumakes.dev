---
import SectionHead from './SectionHead.astro';

const ADDRESS = 'hello@marumakes.dev';
---

<section class="correspondence" aria-labelledby="correspondence">
	<SectionHead
		id="correspondence"
		title="Correspondence"
		meta="Open to graduate &amp; junior roles"
	/>

	<div class="contact">
		<p>
			Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
			incididunt ut labore et dolore magna aliqua.
		</p>
		<div class="reply">
			<a class="write" href={`mailto:${ADDRESS}`}>{ADDRESS}</a>
			<button class="copy" type="button" data-address={ADDRESS} hidden>
				<span class="label">Copy address</span>
			</button>
		</div>
	</div>
</section>

<style>
	.correspondence { padding-top: clamp(2rem, 5vh, 3.4rem); }

	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: end;
		padding-top: 2rem;
	}

	@media (max-width: 820px) {
		.contact { grid-template-columns: 1fr; gap: 1.8rem; align-items: start; }
		.reply { justify-items: start; }
	}

	.contact p { max-width: 46ch; color: var(--ink-soft); }

	.reply { display: grid; justify-items: end; gap: 0.85rem; }

	/* Display type here is Bodoni — mono is reserved for labels at caption
	   size. Roman, not italic: the address is a name, not an aside. */
	.write {
		display: inline-block;
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 3.2vw, 2.3rem);
		font-weight: 400;
		letter-spacing: 0.012em;
		color: var(--gold);
		text-decoration: none;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--gold-mid);
		transition: color 0.3s ease, border-bottom-color 0.3s ease;
	}

	/* The same hover as every other link on the page: ink darkens, rule follows. */
	.write:hover,
	.write:focus-visible { color: var(--ink); border-bottom-color: var(--ink); }

	/* Plenty of people read mail in a browser, where a bare mailto: is a dead end. */
	.copy {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink-faint);
		background: transparent;
		border: 0;
		padding: 0;
		cursor: pointer;
		transition: color 0.25s ease;
	}

	.copy:hover { color: var(--gold); }
	.copy.is-copied { color: var(--mauve); }
	.copy[hidden] { display: none; }
</style>

<script>
	/* The address is a mailto: link first; the copy control is an extra.
	   It stays hidden unless the clipboard is actually available, so there
	   is never a dead control on the page. */
	const CONFIRM_MS = 2200;

	function setUp() {
		if (!navigator.clipboard) {
			return;
		}

		document.querySelectorAll<HTMLButtonElement>('.copy').forEach((button) => {
			const label = button.querySelector<HTMLElement>('.label');
			const address = button.dataset.address;

			if (!label || !address) {
				return;
			}

			const resting = label.textContent ?? '';
			let reset: number | undefined;

			button.hidden = false;

			button.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(address);
				} catch {
					return;
				}

				label.textContent = 'Copied';
				button.classList.add('is-copied');

				window.clearTimeout(reset);
				reset = window.setTimeout(() => {
					label.textContent = resting;
					button.classList.remove('is-copied');
				}, CONFIRM_MS);
			});
		});
	}

	document.addEventListener('astro:page-load', setUp);
</script>
